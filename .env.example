MAX_CONCURRENT_RUNS=1
APP_ENV=development
REGISTRATION_ENABLED=true
CORS_ORIGINS=[]
AUTH_RATE_LIMIT_PER_MINUTE=30
# ============ 基础配置 ============
# 数据库：compose.local.yml 使用 PostgreSQL，离线开发/测试可用 SQLite
# DATABASE_URL=postgresql+psycopg://opspilot:change-me@127.0.0.1:15432/opspilot
# DATABASE_URL=mysql+pymysql://aiops:aiops123@localhost:3306/aiops?charset=utf8mb4
DATABASE_URL=sqlite:///./data/app.db

# ============ 认证 ============
JWT_SECRET=change-me-to-a-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============ 向量库 Qdrant ============
# memory: 进程内（开发/测试）  local: 本地磁盘持久化  remote: 独立服务（Docker 部署）
QDRANT_MODE=memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=kb_chunks

# ============ Embedding / LLM ============
# mock: 离线哈希向量 + 规则式回答（无需 API Key，用于开发与验收）
# openai: 任意 OpenAI 兼容 API（DeepSeek / 智谱 / vLLM 等，改 BASE_URL 即可）
EMBEDDING_PROVIDER=mock
EMBEDDING_DIM=256
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=qwen3.8-max
EMBEDDING_MODEL=text-embedding-3-small

# ============ 检索 ============
DENSE_TOP_K=5
BM25_TOP_K=5
TOP_K=5
RRF_K=60
RERANK_ENABLED=false
# heuristic（离线可用） | cross_encoder（需安装 requirements-optional.txt）
RERANK_PROVIDER=heuristic
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ============ Redis ============
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_PER_MINUTE=60

# ============ Langfuse 可观测（可选，留空则关闭） ============
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ============ 预算门控（真实模型调用统一入口） ============
# 配置账本路径后，chat/tool_chat/Embedding/Rerank 发送前一律先预留，超限在供应商前拒绝。
# 路径留空=不启用（仅离线 Mock 开发使用）；启用时 TOKEN_LIMIT 必须为正，且必须配置
# 分模型授权额度（JSON，按 budget.json p1 列），未授权模型在发送前被拒绝。
BUDGET_LEDGER_PATH=
BUDGET_TOKEN_LIMIT=0
BUDGET_MODEL_LIMITS={}

# PostgreSQL + Qdrant 的低并发本地联调使用 compose.local.yml。
POSTGRES_PASSWORD=
CHAT_MODEL_CANDIDATES=[]
CHAT_MODEL_EXPIRATIONS={}
MAX_TOOL_CALLS=5
LOGS_URL=http://localhost:18081
REMEDIATION_ENABLED=false
MCP_ENABLED=false
RETRIEVAL_SUBAGENT_ENABLED=false
RETRIEVAL_SUBAGENT_TIMEOUT_SECONDS=120
